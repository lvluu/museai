#!/usr/bin/env python3
"""postq - queue social posts (video + title + schedule + account) for one-click approval in the
post-approve Chrome extension, which posts them through your own logged-in session.

  postq add --platform youtube --account "Panda English" --file v.mp4 --title "..." \
            [--caption - ] [--tags a,b] [--cover c.jpg] [--at "2026-11-07 19:00" --tz Asia/Ho_Chi_Minh] \
            [--visibility public|unlisted|private] [--dry-run] [--auto]
  postq add --platform meta --targets facebook,instagram ...   # one Meta Business Suite post for both
  postq episode DIR [--platforms youtube,meta,tiktok,x] [--dry-run] [--no-render]  # from DIR/captions.txt;
                                      # no thumbnail there -> muse renders one
  postq list | results | serve
  postq wait [ID ...] [--timeout S]   # exit 0 posted, 2 failed/discarded, 3 timeout
  postq approve ID ...                # post without a click (Chrome + extension must be running)
"""
