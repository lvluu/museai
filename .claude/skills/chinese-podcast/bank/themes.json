[
  {"id": "t01", "zh": "遇见", "vi": "gặp gỡ", "truth": "有些人仅仅是遇见，便已经很幸运了。"},
  {"id": "t02", "zh": "放下", "vi": "buông bỏ", "truth": "放下不是忘记，是不再让它决定今天。"},
  {"id": "t03", "zh": "慢下来", "vi": "chậm lại", "truth": "走得慢一点，才看得见路边的花。"},
  {"id": "t04", "zh": "爱自己", "vi": "yêu bản thân", "truth": "爱自己，就是不再委屈自己去讨好别人。"},
  {"id": "t05", "zh": "好运", "vi": "may mắn", "truth": "一个人的好运，藏在他温柔的说话方式里。"},
  {"id": "t06", "zh": "离别", "vi": "chia ly", "truth": "好好告别，也是一种爱。"},
  {"id": "t07", "zh": "等待", "vi": "chờ đợi", "truth": "等待的意义，是让自己先变好。"},
  {"id": "t08", "zh": "家", "vi": "nhà", "truth": "家不是一个地方，是有人等你回去。"},
  {"id": "t09", "zh": "父亲", "vi": "cha", "truth": "父亲的爱很少说出口，都藏在小事里。"},
  {"id": "t10", "zh": "母亲", "vi": "mẹ", "truth": "妈妈总说不累，其实她只是习惯了。"},
  {"id": "t11", "zh": "孤独", "vi": "cô đơn", "truth": "学会一个人吃饭，也是一种长大。"},
  {"id": "t12", "zh": "朋友", "vi": "bạn bè", "truth": "真正的朋友，是很久不联系也不会变远的人。"},
  {"id": "t13", "zh": "今天", "vi": "hôm nay", "truth": "人生最好的一天，永远是今天。"},
  {"id": "t14", "zh": "失去", "vi": "mất đi", "truth": "失去的东西，会用另一种方式回来。"},
  {"id": "t15", "zh": "平凡", "vi": "bình thường", "truth": "平凡的日子，才是最珍贵的日子。"},
  {"id": "t16", "zh": "原谅", "vi": "tha thứ", "truth": "原谅别人，其实是放过自己。"},
  {"id": "t17", "zh": "勇气", "vi": "dũng khí", "truth": "勇气不是不害怕，是害怕了还往前走。"},
  {"id": "t18", "zh": "温柔", "vi": "dịu dàng", "truth": "温柔是一种力量，不是软弱。"},
  {"id": "t19", "zh": "错过", "vi": "bỏ lỡ", "truth": "错过的车，会让你看见另一条路。"},
  {"id": "t20", "zh": "成长", "vi": "trưởng thành", "truth": "长大就是，难过的时候也能好好吃饭。"},
  {"id": "t21", "zh": "时间", "vi": "thời gian", "truth": "时间不会治愈一切，但会教你和它相处。"},
  {"id": "t22", "zh": "知足", "vi": "biết đủ", "truth": "知足的人，每天都在过节。"},
  {"id": "t23", "zh": "陌生人", "vi": "người lạ", "truth": "一个陌生人的善意，可以温暖很多年。"},
  {"id": "t24", "zh": "故乡", "vi": "quê hương", "truth": "离开故乡以后，才知道故乡的味道。"},
  {"id": "t25", "zh": "沉默", "vi": "im lặng", "truth": "有时候，沉默是最好的回答。"},
  {"id": "t26", "zh": "坚持", "vi": "kiên trì", "truth": "每天一点点，时间会给你答案。"},
  {"id": "t27", "zh": "初心", "vi": "tâm ban đầu", "truth": "走得再远，也别忘了为什么出发。"},
  {"id": "t28", "zh": "心安", "vi": "lòng an", "truth": "心安的地方，就是最好的地方。"},
  {"id": "t29", "zh": "雨天", "vi": "ngày mưa", "truth": "下雨的时候，就给自己放一天假。"},
  {"id": "t30", "zh": "习惯", "vi": "thói quen", "truth": "我们习惯了一个人，也就习惯了他的离开。"},
  {"id": "t31", "zh": "得失", "vi": "được mất", "truth": "得失皆是寻常，人生一半烟火一半清欢。"},
  {"id": "t32", "zh": "情绪", "vi": "cảm xúc", "truth": "不好的情绪，就像天气，会过去的。"},
  {"id": "t33", "zh": "善良", "vi": "lương thiện", "truth": "善良要有底线，也要有锋芒。"},
  {"id": "t34", "zh": "距离", "vi": "khoảng cách", "truth": "舒服的关系，都有一点距离。"},
  {"id": "t35", "zh": "重新开始", "vi": "bắt đầu lại", "truth": "什么时候开始，都不算晚。"},
  {"id": "t36", "zh": "小确幸", "vi": "hạnh phúc nhỏ", "truth": "幸福就是，刚好赶上最后一班车。"},
  {"id": "t37", "zh": "外婆", "vi": "bà ngoại", "truth": "外婆的家，是童年最长的夏天。"},
  {"id": "t38", "zh": "第一次", "vi": "lần đầu", "truth": "每一个第一次，都值得被记住。"},
  {"id": "t39", "zh": "钱", "vi": "tiền", "truth": "钱能买到很多东西，买不到一顿家里的晚饭。"},
  {"id": "t40", "zh": "身体", "vi": "sức khỏe", "truth": "身体是你唯一一定要住一辈子的地方。"},
  {"id": "t41", "zh": "比较", "vi": "so sánh", "truth": "别拿自己的开头，去比别人的中间。"},
  {"id": "t42", "zh": "拒绝", "vi": "từ chối", "truth": "学会说不，是对自己的温柔。"},
  {"id": "t43", "zh": "回忆", "vi": "ký ức", "truth": "回忆是用来温暖今天的，不是用来困住自己的。"},
  {"id": "t44", "zh": "梦想", "vi": "ước mơ", "truth": "梦想不用很大，能让你早上想起床就好。"},
  {"id": "t45", "zh": "运气", "vi": "vận may", "truth": "你的努力，会悄悄变成你的运气。"},
  {"id": "t46", "zh": "季节", "vi": "mùa", "truth": "每个季节都有它的好，人生也是。"},
  {"id": "t47", "zh": "一个人", "vi": "một mình", "truth": "一个人的时候，也要好好生活。"},
  {"id": "t48", "zh": "说话", "vi": "lời nói", "truth": "好好说话，是最便宜的善良。"},
  {"id": "t49", "zh": "珍惜", "vi": "trân trọng", "truth": "珍惜眼前人，别等失去了才懂。"},
  {"id": "t50", "zh": "晚安", "vi": "chúc ngủ ngon", "truth": "不管今天怎么样，晚上都要好好睡一觉。"},
  {"id": "t51", "zh": "必走", "vi": "ắt sẽ rời đi", "truth": "付出到了一定程度，还得不到回应的人，必走。"},
  {"id": "t52", "zh": "回应", "vi": "sự đáp lại", "truth": "没有人能无条件地付出，感情要靠彼此的回应才能留下来。"},
  {"id": "t53", "zh": "亲人", "vi": "người thân", "truth": "亲人不是血缘决定的，是那颗一直担心你的心。"},
  {"id": "t54", "zh": "磁场", "vi": "năng lượng", "truth": "把自己照顾好，不合适的人会自己走远，对的人会留下来。"},
  {"id": "t55", "zh": "世界", "vi": "thế giới", "truth": "认真生活，不只是为了成功，也是为了去看更大的世界。"},
  {"id": "t56", "zh": "光鲜", "vi": "hào nhoáng", "truth": "别人的光鲜背后都有代价，你看到的只是一半。"},
  {"id": "t57", "zh": "刚认识", "vi": "lúc mới quen", "truth": "人和人刚认识的时候最好，什么都是新的。"},
  {"id": "t58", "zh": "绽放", "vi": "nở rộ", "truth": "在这里你是一朵野花，换个地方也许就是向日葵。"},
  {"id": "t59", "zh": "理所当然", "vi": "điều hiển nhiên", "truth": "别人对你好，不是理所当然，也不是欠你的。"}
]
