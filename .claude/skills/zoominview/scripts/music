#!/usr/bin/env bash
# Usage: music plan.json out_dir [--seed N]
# Writes out_dir/track.m4a + track.beats.json. A file style (wow-ref) is copied with its beat file; an AI style
# is generated by ../muse-video/scripts/music.py (ACE-Step when installed, else MusicGen) as a
# low-passed riser over the reaction that drops exactly when the view opens (plan.reveal_time).
set -euo pipefail
SKILL_DIR=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
plan=$1
out=$(mkdir -p "$2" && cd "$2" && pwd)
shift 2
vars=$(python3 -c '
import json, shlex, sys
m = json.load(open(sys.argv[1]))["music"]
for k in ("file", "style", "bpm", "lyrics", "intro_beats", "body_beats"):
    print("m_" + k + "=" + shlex.quote(str(m.get(k, ""))))' "$plan")
eval "$vars"
if [[ -n $m_file ]]; then
  cp "$m_file" "$out/track.m4a"
  cp "${m_file%.*}.beats.json" "$out/track.beats.json"
  echo "$out/track.m4a (file)"
else
  music_py="$SKILL_DIR/../muse-video/scripts/music.py"
  uv run --no-project "$music_py" --style "$m_style" --lyrics "$m_lyrics" \
    --bpm "$m_bpm" --intro-beats "$m_intro_beats" --body-beats "$m_body_beats" --out "$out/track.m4a" "$@"
  # ACE keeps its own tempo (Madeira: asked 72, sang 92 BPM), which shortens the riser and moves the drop
  # before the reveal; re-shape the same render at the song's real tempo instead of cutting the gasp
  fix=$(python3 -c '
import json, sys
b = json.load(open(sys.argv[1])); p = json.load(open(sys.argv[2]))
beat = 60 / b["bpm"]
if abs((b["drop"] or 0) - p["reveal_time"]) > 0.4:
    print(round(b["bpm"], 2), round(p["reveal_time"] / beat), round((p["length"] - p["reveal_time"]) / beat) + 1)' \
    "$out/track.beats.json" "$plan")
  if [[ -n $fix ]]; then
    read -r bpm intro body <<<"$fix"
    echo "drop off the reveal: re-shaping at $bpm BPM, $intro intro beats"
    uv run --no-project "$music_py" --raw "$out/track.raw.wav" --style "$m_style" --bpm "$bpm" \
      --intro-beats "$intro" --body-beats "$body" --out "$out/track.m4a"
  fi
fi
