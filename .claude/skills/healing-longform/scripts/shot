#!/usr/bin/env bash
# Usage: [IMAGE=still.png] shot "brief" out.mp4
# Renders one long-form shot through muse-video (16:9, 10 s, QUALITY=0) with ../prompt/look.txt appended.
# plan.py clip calls it with IMAGE=stills/sN.png; one job line per shot in a render-queue jobs file.
# Bait words make muse stack props and orange light (healing-video "Real look"); knives and crying looked
# fake (healing-story). BRIEF_OK=1 skips the check.
set -euo pipefail
SKILL_DIR=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
MUSE_VIDEO="$SKILL_DIR/../muse-video/scripts/muse-video"
bait=$(grep -oiE '\b(cos[yi]e?|cozy|magical|dreamy|cinematic|enchant[a-z]*|fairy lights?|glow(ing)?|candle(s|light)?|lamp ?light|bokeh|sparkl[a-z]*|tripod|phone on|cry(ing)?|tears?|knife|knives)\b' <<<"$1" | sort -fu | paste -sd, - || true)
if [[ -n $bait && -z ${BRIEF_OK:-} ]]; then
  echo "shot: brief has bait words ($bait); see SKILL.md Shots" >&2
  exit 2
fi
out=$(cd "$(dirname "$2")" && pwd)/$(basename "$2")
prompt="NO TEXT ON SCREEN. $1

$(cat "$SKILL_DIR/prompt/look.txt")"
QUALITY=0 SIZE=${SIZE:-16:9} DURATION=${DURATION:-10} OUT_NAME=$(basename "$out") NO_OPEN=1 \
  "$MUSE_VIDEO" "$prompt" "$(dirname "$out")"
